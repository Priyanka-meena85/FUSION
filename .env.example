# =============================================================================
# FUSION - THE MAGICAL MIRROR | Environment Configuration
# Copy this file to .env for local development. NEVER commit .env to Git.
# =============================================================================

# Runtime mode: 'development' or 'production'
NODE_ENV=development

# Backend server port
PORT=3001

# Mandatory in production (min 4 chars). Used for Owner /admin login.
ADMIN_PIN=replace-with-strong-owner-pin

# Mandatory in production (min 16 chars; recommended 64-char random hex).
# Used to sign HttpOnly admin session cookies and per-booking access tokens.
SESSION_SECRET=replace-with-64-char-random-hex-secret

# Comma-separated CORS allowlist of frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Razorpay Credentials (UPI / Card Payments)
# In production, missing RAZORPAY_KEY_SECRET will fail payment verification closed.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# WhatsApp Business API (WATI / AiSensy / Interakt)
WHATSAPP_API_URL=https://your-whatsapp-provider.example.com/v1/messages
WHATSAPP_API_TOKEN=replace-with-whatsapp-api-token

# Cloudinary Image Storage (Required in production; local fallback is development-only)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
